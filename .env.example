# Base de datos PostgreSQL.
# El docker-compose que viene con el repo levanta exactamente esta.
DATABASE_URL="postgresql://registro:registro@localhost:5433/registro_tareas?schema=public"

# Clave de la API de Anthropic (https://console.anthropic.com).
ANTHROPIC_API_KEY="sk-ant-..."

# Modelo de visión. Opus 5 es el que mejor lee manuscrito y marcas en tabla.
# Se puede bajar a claude-sonnet-5 para reducir costo por planilla.
ANTHROPIC_MODEL="claude-opus-5"

# Dónde se guardan las fotos originales. Por defecto ./uploads
# UPLOAD_DIR="/var/lib/registro-tareas/uploads"
