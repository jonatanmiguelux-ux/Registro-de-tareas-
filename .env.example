# Base de datos PostgreSQL.
# El docker-compose que viene con el repo levanta exactamente esta.
DATABASE_URL="postgresql://registro:registro@localhost:5433/registro_tareas?schema=public"

# Clave de la API de Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY="..."

# Modelo de visión.
#
# Los modelos "pro" leen mejor el manuscrito, pero NO tienen tier gratuito
# (la cuota libre es 0: dan 429 en la primera lectura). Con una cuenta sin
# facturación hay que usar un "flash". Con facturación activa conviene probar
# un pro y comparar contra el papel.
GEMINI_MODEL="gemini-3.6-flash"

# Dónde se guardan las fotos originales. Por defecto ./uploads
# UPLOAD_DIR="/var/lib/registro-tareas/uploads"

# --- Acceso con cuenta de Google ---
#
# Firma de las sesiones. Generala con:  openssl rand -base64 32
AUTH_SECRET="cualquier-cosa-larga-para-desarrollo"

# Credenciales de Google, en https://console.cloud.google.com
# APIs y servicios → Credenciales → Crear → ID de cliente de OAuth → App web.
# Para desarrollo, el URI de redireccionamiento autorizado es exactamente:
#   http://localhost:3000/api/auth/callback/google
#
# Pegá el valor COMPLETO entre las comillas, sin borrarlas. En la consola de
# Google se llaman "ID de cliente" y "Secreto del cliente"; acá van con estos
# otros nombres, que son los que espera Auth.js.
#   El ID termina en .apps.googleusercontent.com
#   El secreto empieza con GOCSPX-
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Correo, para verificar el contacto de los vecinos ---
#
# Sin esto, el código de verificación se escribe en la consola del servidor en
# vez de enviarse: alcanza para probar en tu PC, pero en producción dejaría
# todos los reclamos sin poder confirmarse.
#
# Con una cuenta de Gmail: activá la verificación en dos pasos y generá una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# (la contraseña normal de Gmail no funciona acá).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_DESDE="Alumbrado público <>"
