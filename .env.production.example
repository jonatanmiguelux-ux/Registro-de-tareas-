# Configuración del servidor de producción.
#
#   cp .env.production.example .env.production
#
# Este archivo NO va al repositorio: tiene las claves.

# Dominio apuntado a la IP del servidor. Caddy saca el certificado HTTPS solo
# la primera vez que alguien entra, así que el DNS tiene que estar propagado
# ANTES de levantar todo.
#
# Este valor tiene que coincidir exactamente con el URI de redireccionamiento
# cargado en Google (ver AUTH_GOOGLE_ID más abajo): mismo dominio, con https
# y sin barra al final.
DOMINIO="registros-de-tareas.com.ar"

# Dominio de la app del vecino.
#
# Desde este dominio la app del municipio no existe: la raíz muestra la página
# que explica el servicio, y cualquier otra dirección —incluso escrita a mano—
# devuelve ahí.
#
# Tiene que apuntar con un registro A a la MISMA IP que el de arriba. Caddy le
# saca su propio certificado, sin configuración adicional.
#
# Si se deja vacío, todo convive en el dominio del municipio y la parte del
# vecino queda en /alumbrado.
DOMINIO_VECINOS="vecinos-lacosta.com.ar"

# Acceso con cuenta de Google.
#
# Cada persona entra con su cuenta y un administrador la habilita desde la
# app. La primera cuenta que entra queda como administradora.
#
# 1. Firma de las sesiones. Generala con:  openssl rand -base64 32
AUTH_SECRET="reemplazame"
#
# 2. Credenciales de Google, en https://console.cloud.google.com
#    APIs y servicios → Credenciales → Crear → ID de cliente de OAuth →
#    Aplicación web. En "URI de redireccionamiento autorizados" va exactamente
#    esto, sin barra al final:
#
#      https://registros-de-tareas.com.ar/api/auth/callback/google
#
#    Y acordate de PUBLICAR la app en la pantalla de consentimiento: en modo
#    "Prueba" sólo entran los correos cargados a mano.
#
#    Pegá el valor COMPLETO entre las comillas, sin borrarlas. En la consola
#    de Google se llaman "ID de cliente" y "Secreto del cliente"; acá van con
#    estos otros nombres, que son los que espera Auth.js.
#      El ID termina en .apps.googleusercontent.com
#      El secreto empieza con GOCSPX-
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Contraseña de Postgres. Inventá una larga; no la vas a tipear nunca.
POSTGRES_PASSWORD="cambiame-por-algo-largo"

# Clave de Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY="AQ.Ab..."

# Los modelos "pro" leen mejor el manuscrito pero NO tienen tier gratuito.
# Con facturación activa conviene probar uno y comparar contra el papel.
GEMINI_MODEL="gemini-3.6-flash"

# Días que se guardan las copias de la base.
RETENCION_DIAS="14"

