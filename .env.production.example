# Configuración del servidor de producción.
#
#   cp .env.production.example .env.production
#
# Este archivo NO va al repositorio: tiene las claves.

# Dominio apuntado a la IP del servidor. Caddy saca el certificado HTTPS solo
# la primera vez que alguien entra, así que el DNS tiene que estar propagado
# ANTES de levantar todo.
DOMINIO="planillas.tu-dominio.com.ar"

# Acceso. Una sola clave para toda la cuadrilla: nadie se registra.
# El hash se genera con:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'la-clave'
# Ojo: si el hash tiene $, duplicalos ($$) o docker compose se los come.
USUARIO="cuadrilla"
CLAVE_HASH="$2a$14$reemplazame..."

# Contraseña de Postgres. Inventá una larga; no la vas a tipear nunca.
POSTGRES_PASSWORD="cambiame-por-algo-largo"

# Clave de Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY="AQ.Ab..."

# Los modelos "pro" leen mejor el manuscrito pero NO tienen tier gratuito.
# Con facturación activa conviene probar uno y comparar contra el papel.
GEMINI_MODEL="gemini-3.6-flash"

# Días que se guardan las copias de la base.
RETENCION_DIAS="14"
