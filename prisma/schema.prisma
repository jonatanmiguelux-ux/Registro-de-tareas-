generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Qué puede hacer una persona dentro de la app.
enum RolUsuario {
  /// Carga, revisa y confirma planillas. Ve todo.
  OPERARIO
  /// Además borra planillas, fija el stock inicial y habilita cuentas.
  ADMINISTRADOR
}

/// Si la cuenta puede entrar.
///
/// Iniciar sesión con Google dice *quién sos*, no si tenés permiso: sin este
/// estado, cualquiera con un Gmail entraría a los partes del municipio.
enum EstadoUsuario {
  /// Pidió acceso y espera que un administrador lo habilite.
  PENDIENTE
  ACTIVO
  /// Se le retiró el acceso. No se borra, para no perder de vista quién fue.
  BLOQUEADO
}

/// Una persona que usa la app.
///
/// La forma de los primeros campos y las tres tablas que siguen (Account,
/// Session, VerificationToken) las impone el adaptador de Auth.js: no se
/// pueden renombrar al castellano sin romperlo. Lo agregado por el proyecto
/// —rol y estado— sí va en castellano, como el resto.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  rol    RolUsuario    @default(OPERARIO)
  estado EstadoUsuario @default(PENDIENTE)

  /// Quién lo habilitó y cuándo, para poder auditar los accesos.
  habilitadoEn  DateTime?
  habilitadoPor String?

  accounts Account[]
  sessions Session[]

  planillasCargadas   Planilla[] @relation("cargadaPor")
  planillasConfirmadas Planilla[] @relation("confirmadaPor")

  creadoEn DateTime @default(now())

  @@index([estado])
  @@map("usuarios")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("cuentas_proveedor")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sesiones")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("tokens_verificacion")
}

/// Estado del procesamiento de una foto de planilla.
enum EstadoPlanilla {
  PROCESANDO
  EN_REVISION
  CONFIRMADA
  ERROR
}

/// Una foto de planilla manuscrita. Cada carga genera una fila nueva:
/// nunca se sobrescribe, así se acumula el histórico de todos los días.
model Planilla {
  id        String         @id @default(cuid())
  estado    EstadoPlanilla @default(PROCESANDO)

  // Archivo original, para poder auditar contra la foto.
  archivoNombre String
  archivoTipo   String
  archivoRuta   String

  // Encabezado de la planilla. Sirve de valor por defecto para las filas
  // cuando el dato figura una sola vez arriba y no se repite por reclamo.
  fecha     DateTime?
  oficial   String?
  chofer    String?
  movil     String?
  localidad String?

  // Trazabilidad de la extracción con IA.
  modelo         String?
  respuestaCruda Json?
  notasIa        String?

  /// Mensaje del fallo, escrito para mostrar en pantalla.
  error String?

  /// El mismo fallo, con el detalle técnico crudo del proveedor.
  ///
  /// Va aparte porque esos textos vienen en inglés y mencionan claves, cuotas
  /// y URLs internas: sirven para diagnosticar, no para mostrarle a quien
  /// está en la calle con el papel.
  errorTecnico String?

  /// Quién la cargó y quién la confirmó.
  ///
  /// El vínculo es opcional y no borra en cascada: si mañana se da de baja a
  /// una persona, sus planillas tienen que seguir existiendo. El histórico es
  /// el activo del sistema, no las cuentas.
  cargadaPorId    String?
  cargadaPor      User?   @relation("cargadaPor", fields: [cargadaPorId], references: [id], onDelete: SetNull)
  confirmadaPorId String?
  confirmadaPor   User?   @relation("confirmadaPor", fields: [confirmadaPorId], references: [id], onDelete: SetNull)

  reclamos Reclamo[]

  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  confirmadoEn  DateTime?

  @@index([creadoEn])
  @@index([cargadaPorId])
  @@index([estado])
  @@map("planillas")
}

/// Una fila de la planilla: un reclamo atendido.
model Reclamo {
  id         String   @id @default(cuid())
  planillaId String
  planilla   Planilla @relation(fields: [planillaId], references: [id], onDelete: Cascade)

  /// Orden de la fila dentro de la planilla, para conservar la lectura original.
  orden Int

  fecha        DateTime?
  oficial      String?
  chofer       String?
  movil        String?
  localidad    String?
  tipoReclamo  String?
  fechaIngreso DateTime?
  nroIncidente String?
  calle        String?
  numero       String?
  observaciones String?

  /// Qué se encontró o se hizo: "Cable Cortado", "Falso Contacto", "Funciona
  /// Normal". En el papel se escribe como sigla (C/C, F/C, F/N) en la misma
  /// zona que los materiales, pero no es un material: no consume stock.
  diagnostico String?

  /// Qué tan segura estuvo la IA de esta fila: alta | media | baja.
  confianza String?
  /// Marca si una persona revisó y corrigió la fila a mano.
  revisado  Boolean @default(false)

  materiales ReclamoMaterial[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([planillaId, orden])
  @@index([fecha])
  @@index([nroIncidente])
  @@map("reclamos")
}

/// Catálogo de columnas de materiales de la planilla. Es configurable:
/// las columnas que la IA lee y todavía no existen se dan de alta solas.
model Material {
  id     String  @id @default(cuid())
  nombre String  @unique
  /// Grupo de la planilla: "Lámparas", "Balastos" u "Otros materiales".
  grupo  String?
  unidad String?
  orden  Int     @default(0)
  activo Boolean @default(true)

  /// Si tiene una columna propia impresa en la planilla.
  ///
  /// Los que no la tienen (el Adaptador, que se anota "AD" a mano al lado de
  /// la lámpara) son materiales de pleno derecho y consumen stock, pero no
  /// deben entrar en la lista ordenada de columnas que se le pasa al modelo
  /// como referencia: esa lista sirve para contar casilleros, y un nombre de
  /// más ahí corre todas las marcas siguientes.
  columnaImpresa Boolean @default(true)

  /// Punto de partida del stock. Es un valor que se corrige, no un movimiento:
  /// volver a cargarlo reemplaza el anterior en vez de sumarse.
  stockInicial Float @default(0)

  reclamos     ReclamoMaterial[]
  movimientos  MovimientoStock[]

  creadoEn DateTime @default(now())

  @@index([orden])
  @@index([grupo])
  @@map("materiales")
}

/// La X (o la cantidad) de una columna de materiales en una fila concreta.
model ReclamoMaterial {
  id         String  @id @default(cuid())
  reclamoId  String
  reclamo    Reclamo @relation(fields: [reclamoId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  /// Cantidad escrita en la celda. Si sólo había una X, vale 1.
  cantidad Float @default(1)

  @@unique([reclamoId, materialId])
  @@index([materialId])
  @@map("reclamo_materiales")
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

/// Movimiento de depósito cargado a mano.
///
/// Acá NO van los materiales gastados en los reclamos: esos ya están en
/// `ReclamoMaterial` y se descuentan solos del stock cuando la planilla se
/// confirma. Cargarlos también acá los restaría dos veces.
///
/// Las SALIDA de esta tabla son para lo que no pasa por una planilla: una
/// rotura, un traspaso a otra cuadrilla, un faltante de inventario.
model MovimientoStock {
  id         String         @id @default(cuid())
  materialId String
  material   Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  tipo       TipoMovimiento
  cantidad   Float
  fecha      DateTime       @default(now())
  nota       String?

  creadoEn DateTime @default(now())

  @@index([materialId, fecha])
  @@index([tipo])
  @@map("movimientos_stock")
}

// ---------------------------------------------------------------------------
// Reclamos que cargan los vecinos.
//
// Esta parte es independiente de todo lo anterior: no toca las planillas, ni
// los reclamos de las cuadrillas, ni el stock. Un vecino carga acá lo que hoy
// tiene que ir a decir a la delegación, y alguien del municipio lo pasa al
// sistema oficial, que es el que sigue emitiendo el N.º de incidente.
//
// A propósito NO se genera un número propio: dos numeraciones conviviendo
// terminarían en que la cuadrilla recibe papeles que no cierran con el
// sistema. Acá se guarda el número oficial una vez que existe.
// ---------------------------------------------------------------------------

/// Qué le pasa a la luminaria, según el vecino.
enum TipoFalla {
  /// No enciende.
  NO_FUNCIONA
  /// Queda prendida de día.
  ENCENDIDA
  /// Prende y apaga sola.
  INTERMITENTE
}

enum EstadoReclamoVecinal {
  /// Cargado, pero el vecino todavía no confirmó su correo.
  SIN_VERIFICAR
  /// Verificado y a la espera de que alguien lo pase al sistema oficial.
  RECIBIDO
  /// Ya cargado en el sistema oficial: tiene N.º de incidente.
  DERIVADO
  /// Se descartó (repetido, fuera de jurisdicción, sin datos suficientes).
  DESCARTADO
}

model ReclamoVecinal {
  id String @id @default(cuid())

  /// Código corto que se le da al vecino para seguir su reclamo.
  /// Es lo único que sale a la calle: no expone el id interno.
  codigo String @unique

  tipo         TipoFalla
  localidad    String
  calle        String
  numero       String
  observacion  String

  /// Foto de la luminaria. Se guarda igual que las de las planillas.
  fotoRuta String

  /// Correo del vecino, verificado con un código antes de que el reclamo
  /// entre. Es lo que frena que alguien cargue cien reclamos falsos.
  contacto String

  estado EstadoReclamoVecinal @default(SIN_VERIFICAR)

  /// Código de verificación, guardado como hash: si alguien llegara a leer la
  /// base, no le sirve para confirmar reclamos ajenos.
  verificacionHash    String?
  verificacionExpira  DateTime?
  verificacionIntentos Int      @default(0)
  verificadoEn        DateTime?

  /// El número que devuelve el sistema oficial al cargarlo, y quién lo cargó.
  nroIncidente String?
  derivadoEn   DateTime?
  derivadoPor  String?

  /// Nota interna del municipio. No se le muestra al vecino.
  notaInterna String?

  creadoEn DateTime @default(now())

  @@index([estado, creadoEn])
  @@index([localidad, calle])
  @@map("reclamos_vecinales")
}
