# Servidor web de producción.
#
# Caddy saca y renueva el certificado HTTPS solo con Let's Encrypt, con sólo
# apuntar cada dominio a la IP del servidor. No hay que tocar nada más: sin
# HTTPS los celulares no habilitan la cámara ni instalan la app.
#
# **Los dos dominios se atienden en el mismo bloque.** Quién ve qué lo decide
# la app según el dominio por el que entró la petición (ver DOMINIO_VECINOS en
# .env.production): desde el del vecino, la app del municipio no existe.
#
# Se hace así y no con dos bloques porque DOMINIO_VECINOS es opcional: si
# estuviera en un bloque propio y quedara vacío, Caddy no arrancaría. Acá,
# vacío simplemente no agrega un segundo dominio y todo sigue funcionando en
# uno solo, con la parte del vecino en /alumbrado.
{$DOMINIO} {$DOMINIO_VECINOS} {
	encode zstd gzip

	# Tope de cuerpo, un poco arriba del límite de 20 MB que valida la app:
	# así una foto enorme se rechaza acá y no ocupa memoria del servidor.
	request_body {
		max_size 25MB
	}

	# El control de acceso lo hace la app, no este servidor: cada persona
	# entra con su cuenta de Google y un administrador la habilita.

	# La lectura de una planilla tarda entre 20 y 40 segundos.
	reverse_proxy app:3000 {
		transport http {
			response_header_timeout 5m
			read_timeout 5m
		}
	}
}
